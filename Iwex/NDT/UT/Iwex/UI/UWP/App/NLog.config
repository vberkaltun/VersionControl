<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      autoReload="true">

  <targets>
    <target name="Debugger"
            xsi:type="Debugger"
            layout="${date:format=HH\:mm\:ss.fff} ${pad:padding=-5:inner=${level}} | ${logger} | ${message} ${exception:format=message}" />
    <!--
      - ConcurrentWrites should be 'false' in UWP.
      - Archiving directly to the log folder, to let NLog cleanup old logs.
      @see https://github.com/nlog/NLog/wiki/File-target
    -->
    <target name="File"
            xsi:type="File"
            layout="${date:format=HH\:mm\:ss.fff} ${pad:padding=-5:inner=${level}} ${pad:padding=3:inner=${threadid}} | ${logger} | ${message} ${exception:format=message:maxInnerExceptionLevel=5:innerExceptionSeparator= }"
            fileName="${var:LogPath}\${cached:${date:format=yyyy-MM-dd HH_mm_ss}}.log"
            archiveFileName="${var:LogPath}\{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd HH_mm_ss"
            archiveEvery="Day"
            maxArchiveFiles="100"
            concurrentWrites="false" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="File,Debugger" final="true" />
  </rules>

  <!-- Include NLog.config from 'C:\Users\<user>\AppData\Local\Packages\<app_id>\LocalState' if available. -->
  <include file="${specialfolder:folder=LocalApplicationData}\NLog.config" ignoreErrors="true" />

</nlog>
