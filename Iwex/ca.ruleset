<?xml version="1.0"?>
<RuleSet Name="All Rules with default action" Description="All Rules with default action. Rules with IsEnabledByDefault = false are disabled." ToolsVersion="15.0">
  <Rules AnalyzerId="Microsoft.CodeAnalysis.CSharp.CodeStyle" RuleNamespace="Microsoft.CodeAnalysis.CSharp.CodeStyle">
    <Rule Id="IDE0004" Action="Warning" />         <!-- Remove unnecessary cast -->
    <Rule Id="IDE0005" Action="Warning" />         <!-- Remove unnecessary using directives -->
    <Rule Id="IDE0041" Action="Warning" />         <!-- Use 'is null' check -->
    <Rule Id="IDE0051" Action="Warning" />         <!-- Remove unused private member -->
    <Rule Id="IDE0052" Action="Warning" />         <!-- Remove unread private member -->
    <Rule Id="IDE0290" Action="None" />            <!-- Use primary constructor -->
  </Rules>
  <Rules AnalyzerId="Microsoft.CodeAnalysis.NetAnalyzers" RuleNamespace="Microsoft.CodeAnalysis.NetAnalyzers">
    <Rule Id="CA1003" Action="Warning" />          <!-- Use generic event handler instances -->
    <Rule Id="CA1008" Action="Warning" />          <!-- Enums should have zero value -->
    <Rule Id="CA1014" Action="None" />             <!-- Mark assemblies with CLSCompliantAttribute -->
    <Rule Id="CA1024" Action="Info" />             <!-- Use properties where appropriate -->    
    <Rule Id="CA1031" Action="None" />             <!-- Do not catch general exception types -->
    <Rule Id="CA1303" Action="None" />             <!-- Do not pass literals as localized parameters -->
    <Rule Id="CS1591" Action="Info" />             <!-- Missing XML comment for publicly visible type or member -->
    <Rule Id="CA1711" Action="Warning" />          <!-- Identifiers should not have incorrect suffix -->
    <Rule Id="CA1814" Action="None" />             <!-- Prefer jagged arrays over multidimensional -->
    <Rule Id="CA1819" Action="None" />             <!-- Properties should not return arrays -->
    <Rule Id="CA1859" Action="None" />             <!-- Use concrete types when possible for improved performance. - Prefer abstraction over performance. -->
    <Rule Id="CA5394" Action="None" />             <!-- Random is an insecure random number generator. Use cryptographically secure random number generators when randomness is required for security. -->
  </Rules>
  <Rules AnalyzerId="StyleCop.Analyzers" RuleNamespace="StyleCop.Analyzers">
    <!-- Special Rules -->
    <Rule Id="SA0001" Action="None" />             <!-- XmlCommentAnalysisDisabled -->

    <!-- Readability Rules -->
    <Rule Id="SA1101" Action="None" />             <!-- Prefix Local Calls With This -->

    <!-- Ordering Rules -->
    <Rule Id="SA1200" Action="None" />             <!-- Using Directives Must Be Placed Correctly -->

    <!-- Naming Rules -->
    <Rule Id="SA1309" Action="None" />             <!-- Field names must not begin with an underscore -->
    <Rule Id="SX1309" Action="Warning" />          <!-- Field names must begin with an underscore -->
    <Rule Id="SA1649" Action="Info" />             <!-- File name must match the first member -->

    <!-- Maintainability Rules -->
    <Rule Id="SA1402" Action="None" />             <!-- File May only Contain A Single Class - Handled by RCS1060 -->
    <Rule Id="SA1407" Action="None" />             <!-- Arithmetic expressions should declare precedence - Handled by IDE0048 -->

    <!-- Documentation Rules -->
    <Rule Id="SA1600" Action="None" />             <!-- Elements should be documentated -->
    <Rule Id="SA1601" Action="None" />             <!-- Partial elements should be documentated -->
    <Rule Id="SA1604" Action="None" />             <!-- Element documentation must have a summary -->
    <Rule Id="SA1611" Action="None" />             <!-- The documentation for parameter 'X' is missing -->
    <Rule Id="SA1615" Action="None" />             <!-- Element return value should be documented -->
    <Rule Id="SA1618" Action="None" />             <!-- The documentation for type parameter 'T' is missing -->
    <Rule Id="SA1633" Action="None" />             <!-- File must have header -->
    <Rule Id="SA1652" Action="None" />             <!-- Enable xml documentation output -->
  </Rules>
  <Rules AnalyzerId="Roslynator.CSharp.Analyzers" RuleNamespace="Roslynator.CSharp.Analyzers">
    <Rule Id="RCS1001" Action="Warning" />     <!-- Add braces (when expression spans over multiple lines) -->
    <Rule Id="RCS1003" Action="Warning" />     <!-- Add braces to if-else (when expression spans over multiple lines) -->
    <Rule Id="RCS1005" Action="Warning" />     <!-- Simplify nested using statement -->
    <Rule Id="RCS1006" Action="Warning" />     <!-- Merge else clause with nested if statement -->
    <Rule Id="RCS1007" Action="Warning" />     <!-- Add braces -->
    <Rule Id="RCS1010" Action="Warning" />     <!-- Use 'var' instead of explicit type (when the type is obvious) -->
    <Rule Id="RCS1013" Action="Warning" />     <!-- Use predefined type -->
    <Rule Id="RCS1015" Action="Warning" />     <!-- Use nameof operator -->
    <Rule Id="RCS1016a" Action="Warning" />    <!-- Avoid multiline expression body -->
    <Rule Id="RCS1018" Action="Warning" />     <!-- Add accessibility modifiers -->
    <Rule Id="RCS1020" Action="Warning" />     <!-- Simplify Nullable<T> to T? -->
    <Rule Id="RCS1021" Action="Warning" />     <!-- Simplify lambda expression -->
    <Rule Id="RCS1024" Action="None" />        <!-- Format accessor list -->
    <Rule Id="RCS1025" Action="Warning" />     <!-- Add new line before enum member -->
    <Rule Id="RCS1026" Action="Warning" />     <!-- Add new line before statement -->
    <Rule Id="RCS1027" Action="Warning" />     <!-- Add new line before embedded statement -->
    <Rule Id="RCS1029" Action="None" />        <!-- Format binary operator on next line -->
    <Rule Id="RCS1030" Action="Warning" />     <!-- Add empty line after embedded statement -->
    <Rule Id="RCS1031" Action="None" />        <!-- Remove unnecessary braces - Contradicts RCS1111 -->
    <Rule Id="RCS1032" Action="Warning" />     <!-- Remove redundant parentheses -->
    <Rule Id="RCS1033" Action="Warning" />     <!-- Remove redundant boolean literal -->
    <Rule Id="RCS1034" Action="Warning" />     <!-- Remove redundant 'sealed' modifier -->
    <Rule Id="RCS1036" Action="None" />        <!-- Remove redundant empty line - Handled by SA1507 -->
    <Rule Id="RCS1037" Action="Warning" />     <!-- Remove trailing white-space -->
    <Rule Id="RCS1038" Action="Warning" />     <!-- Remove empty statement -->
    <Rule Id="RCS1039" Action="Warning" />     <!-- Remove argument list from attribute -->
    <Rule Id="RCS1040" Action="Warning" />     <!-- Remove empty else clause -->
    <Rule Id="RCS1041" Action="None" />        <!-- Remove empty initializer - deprecated, use RCS1259 -->
    <Rule Id="RCS1042" Action="Warning" />     <!-- Remove enum default underlying type -->
    <Rule Id="RCS1043" Action="Warning" />     <!-- Remove 'partial' modifier from type with a single part -->
    <Rule Id="RCS1044" Action="Warning" />     <!-- Remove original exception from throw statement -->
    <Rule Id="RCS1045" Action="Warning" />     <!-- Rename private field according to camel case with underscore -->
    <Rule Id="RCS1046" Action="Warning" />     <!-- Asynchronous method name should end with 'Async' -->
    <Rule Id="RCS1047" Action="Warning" />     <!-- Non-asynchronous method name should not end with 'Async' -->
    <Rule Id="RCS1048" Action="Warning" />     <!-- Use lambda expression instead of anonymous method -->
    <Rule Id="RCS1049" Action="Warning" />     <!-- Simplify boolean comparison -->
    <Rule Id="RCS1052" Action="Warning" />     <!-- Declare each attribute separately -->
    <Rule Id="RCS1057" Action="Warning" />     <!-- Add empty line between declarations-->
    <Rule Id="RCS1059" Action="Warning" />     <!-- Avoid locking on publicly accessible instance -->
    <Rule Id="RCS1060" Action="Warning" />     <!-- Declare each type in separate file -->
    <Rule Id="RCS1061" Action="Warning" />     <!-- Merge if statement with nested if statement -->
    <Rule Id="RCS1062" Action="Warning" />     <!-- Avoid interpolated string with no interpolation -->
    <Rule Id="RCS1063" Action="Warning" />     <!-- Avoid usage of do statement to create an infinite loop -->
    <Rule Id="RCS1064" Action="Warning" />     <!-- Avoid usage of for statement to create an infinite loop -->
    <Rule Id="RCS1066" Action="Warning" />     <!-- Remove empty finally clause -->
    <Rule Id="RCS1067" Action="Warning" />     <!-- Remove argument list from object creation expression -->
    <Rule Id="RCS1068" Action="Warning" />     <!-- Simplify logical negation -->
    <Rule Id="RCS1070" Action="Warning" />     <!-- Remove redundant default switch section -->
    <Rule Id="RCS1071" Action="Warning" />     <!-- Remove redundant base constructor call -->
    <Rule Id="RCS1072" Action="Warning" />     <!-- Remove empty namespace declaration -->
    <Rule Id="RCS1073" Action="Warning" />     <!-- Convert 'if' to 'return' statement -->
    <Rule Id="RCS1074" Action="Warning" />     <!-- Remove redundant constructor -->
    <Rule Id="RCS1075" Action="Warning" />     <!-- Avoid empty catch clause that catches System.Exception -->
    <Rule Id="RCS1076" Action="Warning" />     <!-- Format declaration braces -->
    <Rule Id="RCS1077" Action="None" />        <!-- Optimize LINQ method call -->
    <Rule Id="RCS1079" Action="Warning" />     <!-- Throwing of new NotImplementedException -->
    <Rule Id="RCS1080" Action="None" />        <!-- Use 'Count/Length' property instead of 'Any' method -->
    <Rule Id="RCS1081" Action="Warning" />     <!-- Split variable declaration -->
    <Rule Id="RCS1084" Action="Warning" />     <!-- Use coalesce expression instead of conditional expression -->
    <Rule Id="RCS1085" Action="Warning" />     <!-- Use auto-implemented property -->
    <Rule Id="RCS1088" Action="Warning" />     <!-- Use space(s) instead of tab -->
    <Rule Id="RCS1091" Action="Warning" />     <!-- Remove empty region -->
    <Rule Id="RCS1093" Action="Warning" />     <!-- Remove file with no code -->
    <Rule Id="RCS1097" Action="Warning" />     <!-- Remove redundant 'ToString' call -->
    <Rule Id="RCS1098" Action="None" />        <!-- Avoid 'null' on the left side of a binary expression - Handled by SA1131 -->
    <Rule Id="RCS1099" Action="Warning" />     <!-- Default label should be the last label in a switch section -->
    <Rule Id="RCS1101" Action="Info" />        <!-- Format documentation summary on multiple lines -->
    <Rule Id="RCS1102" Action="Warning" />     <!-- Make class static -->
    <Rule Id="RCS1103" Action="Warning" />     <!-- Convert 'if' to assignment -->
    <Rule Id="RCS1104" Action="Warning" />     <!-- Simplify conditional expression -->
    <Rule Id="RCS1105" Action="Warning" />     <!-- Unnecessary interpolation -->
    <Rule Id="RCS1106" Action="Warning" />     <!-- Remove empty destructor -->
    <Rule Id="RCS1107" Action="Warning" />     <!-- Remove redundant 'ToCharArray' call -->
    <Rule Id="RCS1108" Action="Warning" />     <!-- Add 'static' modifier to all partial class declarations -->
    <Rule Id="RCS1110" Action="Warning" />     <!-- Declare type inside namespace -->
    <Rule Id="RCS1111" Action="Warning" />     <!-- Add braces to switch section with multiple statements -->
    <Rule Id="RCS1112" Action="Warning" />     <!-- Combine 'Enumerable.Where' method chain -->
    <Rule Id="RCS1113" Action="Warning" />     <!-- Use 'string.IsNullOrEmpty' method -->
    <Rule Id="RCS1114" Action="Warning" />     <!-- Remove redundant delegate creation -->
    <Rule Id="RCS1118" Action="Warning" />     <!-- Mark local variable as const -->
    <Rule Id="RCS1123" Action="None" />        <!-- Add parentheses according to operator precedence - Handled by IDE0048 -->
    <Rule Id="RCS1124" Action="Hidden" />      <!-- Inline local variable -->
    <Rule Id="RCS1126" Action="Warning" />     <!-- Add braces to if-else -->
    <Rule Id="RCS1127" Action="Warning" />     <!-- Merge local declaration with assignment -->
    <Rule Id="RCS1128" Action="None" />        <!-- Use coalesce expression -->
    <Rule Id="RCS1129" Action="Warning" />     <!-- Remove redundant field initalization -->
    <Rule Id="RCS1130" Action="Warning" />     <!-- Bitwise operation on enum without Flags attribute -->
    <Rule Id="RCS1132" Action="Warning" />     <!-- Remove redundant overriding member -->
    <Rule Id="RCS1133" Action="Warning" />     <!-- Remove redundant Dispose/Close call -->
    <Rule Id="RCS1135" Action="Warning" />     <!-- Declare enum member with zero value (when enum has FlagsAttribute) -->
    <Rule Id="RCS1136" Action="Warning" />     <!-- Merge switch sections with equivalent content -->
    <Rule Id="RCS1139" Action="None" />        <!-- Add summary element to documentation comment. -->
    <Rule Id="RCS1143" Action="Warning" />     <!-- Simplify coalesce expression -->
    <Rule Id="RCS1145" Action="Warning" />     <!-- Remove redundant 'as' operator -->
    <Rule Id="RCS1146" Action="Hidden" />      <!-- Use conditional access -->
    <Rule Id="RCS1151" Action="Warning" />     <!-- Remove redundant cast -->
    <Rule Id="RCS1154" Action="Warning" />     <!-- Sort enum members -->
    <Rule Id="RCS1157" Action="Warning" />     <!-- Composite enum value contains undefined flag -->
    <Rule Id="RCS1158" Action="Warning" />     <!-- Static member in generic type should use a type parameter -->
    <Rule Id="RCS1159" Action="Warning" />     <!-- Use EventHandler<T> -->
    <Rule Id="RCS1160" Action="Warning" />     <!-- Abstract type should not have public constructors -->
    <Rule Id="RCS1162" Action="Warning" />     <!-- Avoid chain of assignments -->
    <Rule Id="RCS1163" Action="None" />        <!-- Unused parameter. Handled by CA1801 -->
    <Rule Id="RCS1164" Action="Warning" />     <!-- Unused type parameter -->
    <Rule Id="RCS1165" Action="None" />        <!-- Unconstrained type parameter checked for null -->
    <Rule Id="RCS1166" Action="Warning" />     <!-- Value type object is never equal to null -->
    <Rule Id="RCS1168" Action="Warning" />     <!-- Parameter name differs from base name -->
    <Rule Id="RCS1169" Action="Warning" />     <!-- Make field read-only -->
    <Rule Id="RCS1170" Action="Warning" />     <!-- Use read-only auto-implemented property -->
    <Rule Id="RCS1171" Action="Warning" />     <!-- Simplify lazy initialization -->
    <Rule Id="RCS1173" Action="Warning" />     <!-- Use coalesce expression instead of if -->
    <Rule Id="RCS1175" Action="Warning" />     <!-- Unused this parameter -->
    <Rule Id="RCS1177" Action="Warning" />     <!-- Use 'var' instead of explicit type (in foreach) -->
    <Rule Id="RCS1182" Action="Warning" />     <!-- Remove redundant base interface -->
    <Rule Id="RCS1185" Action="Warning" />     <!-- Format single-line block -->
    <Rule Id="RCS1186" Action="Warning" />     <!-- Use Regex instance instead of static method -->
    <Rule Id="RCS1187" Action="Warning" />     <!-- Use constant instead of field -->
    <Rule Id="RCS1188" Action="Warning" />     <!-- Remove redundant auto-property initialization -->
    <Rule Id="RCS1190" Action="Warning" />     <!-- Join string expressions -->
    <Rule Id="RCS1191" Action="Warning" />     <!-- Declare enum value as combination of names -->
    <Rule Id="RCS1196" Action="Warning" />     <!-- Call extension method as instance method -->
    <Rule Id="RCS1197" Action="Warning" />     <!-- Optimize StringBuilder.Append/AppendLine call -->
    <Rule Id="RCS1198" Action="None" />        <!-- Avoid unnecessary boxing of value type -->
    <Rule Id="RCS1202" Action="Warning" />     <!-- Avoid NullReferenceException -->
    <Rule Id="RCS1204" Action="Warning" />     <!-- Use EventArgs.Empty -->
    <Rule Id="RCS1205" Action="Warning" />     <!-- Order named arguments according to the order of parameters -->
    <Rule Id="RCS1206" Action="Warning" />     <!-- Use conditional access instead of conditional expression -->
    <Rule Id="RCS1207" Action="Warning" />     <!-- Use method group instead of anonymous function -->
    <Rule Id="RCS1209" Action="Warning" />     <!-- Order type parameter constraints -->
    <Rule Id="RCS1211" Action="Warning" />     <!-- Remove unnecessary else clause -->
    <Rule Id="RCS1212" Action="Hidden" />      <!-- Remove redundant assignment -->
    <Rule Id="RCS1213" Action="None" />        <!-- Remove unused member declaration - Handled by CA1823 -->
    <Rule Id="RCS1214" Action="Warning" />     <!-- Unnecessary interpolated string -->
    <Rule Id="RCS1216" Action="Warning" />     <!-- Unnecessary unsafe context -->
    <Rule Id="RCS1218" Action="Warning" />     <!-- Simplify code branching -->
    <Rule Id="RCS1219" Action="None" />        <!-- Call 'Enumerable.Skip' and 'Enumerable.Any' instead of 'Enumerable.Count' -->
    <Rule Id="RCS1220" Action="Warning" />     <!-- Use pattern matching instead of combination of 'is' operator and cast operator -->
    <Rule Id="RCS1221" Action="Warning" />     <!-- Use pattern matching instead of combination of 'as' operator and null check -->
    <Rule Id="RCS1222" Action="Warning" />     <!-- Merge preprocessor directives -->
    <Rule Id="RCS1224" Action="Warning" />     <!-- Make method an extension method -->
    <Rule Id="RCS1227" Action="Warning" />     <!-- Validate arguments correctly -->
    <Rule Id="RCS1228" Action="None" />        <!-- Unused element in documentation comment - Handled by SA1614, SA1616 -->
    <Rule Id="RCS1229" Action="Warning" />     <!-- Use async/await when necessary -->
    <Rule Id="RCS1230" Action="Warning" />     <!-- Unnecessary usage of enumerator -->
    <Rule Id="RCS1231" Action="None" />        <!-- Make parameter ref read-only -->
    <Rule Id="RCS1232" Action="Warning" />     <!-- Order elements in documentation comment -->
    <Rule Id="RCS1233" Action="Warning" />     <!-- Use short-circuiting operator -->
    <Rule Id="RCS1234" Action="Warning" />     <!-- Duplicate enum value -->
    <Rule Id="RCS1235" Action="Warning" />     <!-- Optimize method call -->
    <Rule Id="RCS1236" Action="Warning" />     <!-- Use exception filter -->
    <Rule Id="RCS1239" Action="Warning" />     <!-- Use 'for' statement instead of 'while' statement -->
    <Rule Id="RCS1240" Action="Warning" />     <!-- Operator is unnecessary -->
    <Rule Id="RCS1241" Action="None" />        <!-- Implement non-generic counterpart -->
    <Rule Id="RCS1259" Action="Warning" />     <!-- Remove empty initializer -->
  </Rules>
</RuleSet>
